# ==========================================================================
# 콘텐츠 저장 모드
# "local"  : Supabase 없이 프로젝트 폴더 내 JSON 파일 + public/uploads 로 동작 (기본값, 지금 바로 실행 가능)
# "supabase" : 아래 Supabase 값들을 채우면 실제 데이터베이스/스토리지로 전환
# ==========================================================================
DATA_MODE=local

# --------------------------------------------------------------------------
# Supabase 설정 (DATA_MODE=supabase 일 때만 필요, supabase/schema.sql 참고)
# --------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------------
# 관리자 인증
# local 모드: 아래 비밀번호로 로그인 (반드시 배포 전 변경)
# supabase 모드: Supabase Auth 이메일/비밀번호 계정을 사용 (ADMIN_PASSWORD는 무시됨)
# --------------------------------------------------------------------------
ADMIN_PASSWORD=change-me-before-deploy
SESSION_SECRET=please-change-this-to-a-random-long-string

# 자동 로그아웃 시간(분)
SESSION_TIMEOUT_MINUTES=30
